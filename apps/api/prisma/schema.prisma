generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model ElfAccount {
  id                    String    @id @default(uuid())
  email                 String    @unique
  displayName           String
  passwordHash          String
  status                String
  verificationTokenHash String?
  verificationExpiresAt DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}
