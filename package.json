{
  "name": "north-pole-hr",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"@north-pole/*\" dev",
    "dev:api": "pnpm --filter @north-pole/api dev",
    "dev:web": "pnpm --filter @north-pole/web dev",
    "build": "pnpm run -r build",
    "test": "pnpm --filter @north-pole/api test",
    "test:unit": "pnpm --filter @north-pole/api test:unit",
    "test:integration": "pnpm --filter @north-pole/api test:integration",
    "test:e2e": "pnpm --filter @north-pole/api test:e2e",
    "db:push": "pnpm --filter @north-pole/api db:push"
  },
  "engines": {
    "node": ">=20"
  }
}
